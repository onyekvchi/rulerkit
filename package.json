{
  "name": "inspectkit",
  "version": "0.3.0",
  "description": "Figma-style layout inspection for your running app: measure distances, rulers with guides, layout grids and a spacing lint.",
  "keywords": [
    "react",
    "design",
    "measure",
    "redlines",
    "spacing",
    "rulers",
    "inspect",
    "lint",
    "layout-grid",
    "devtools",
    "design-engineering"
  ],
  "license": "MIT",
  "author": "Onyekachi Mbaike",
  "homepage": "https://github.com/onyekvchi/inspectkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onyekvchi/inspectkit.git"
  },
  "bugs": {
    "url": "https://github.com/onyekvchi/inspectkit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
